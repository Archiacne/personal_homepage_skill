---
import PostCard from "../../../components/PostCard.astro";
import { site, ui, type Locale } from "../../../data/site";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getPublishedPosts } from "../../../lib/content";
import { localizedPath } from "../../../lib/i18n";

const locale: Locale = "en";
const labels = ui[locale];
const posts = await getPublishedPosts(locale);
---

<BaseLayout
  locale={locale}
  title={`${labels.blogTitle} — ${site.displayName}`}
  description={labels.blogIntro}
  languageHref={localizedPath("zh-CN", "/blog/")}
  alternates={[{ locale: "zh-CN", href: localizedPath("zh-CN", "/blog/") }]}
>
  <section class="shell listing-page">
    <p class="eyebrow">{site.displayName}</p>
    <h1>{labels.blogTitle}</h1>
    <p class="lede">{labels.blogIntro}</p>
    <div class="post-list">
      {posts.length > 0
        ? posts.map((post) => <PostCard post={post} locale={locale} />)
        : <p class="empty-state">{labels.emptyPosts}</p>}
    </div>
  </section>
</BaseLayout>

