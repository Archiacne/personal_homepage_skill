---
import { site, ui, type Locale } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const locale: Locale = "en";
const labels = ui[locale];
const details = [
  site.location && { label: labels.location, value: site.location },
  site.company && { label: labels.company, value: site.company },
  site.email && { label: labels.email, value: site.email },
].filter(Boolean) as { label: string; value: string }[];
---

<BaseLayout locale={locale} title={`${labels.aboutTitle} — ${site.displayName}`}>
  <article class="shell prose-page">
    <p class="eyebrow">{site.displayName}</p>
    <h1>{labels.aboutTitle}</h1>
    <p class="lede">{site.bio}</p>

    <section>
      <h2>{labels.focusTitle}</h2>
      <p>{site.currentFocus}</p>
    </section>

    {details.length > 0 && (
      <section>
        <h2>{labels.detailsTitle}</h2>
        <dl>
          {details.map((detail) => <><dt>{detail.label}</dt><dd>{detail.value}</dd></>)}
        </dl>
      </section>
    )}
  </article>
</BaseLayout>
