---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site, ui, type Locale } from "../data/site";
import "../styles/global.css";

interface Alternate {
  locale: Locale;
  href: string;
}

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  languageHref?: string;
  alternates?: Alternate[];
  article?: {
    publishedAt: Date;
    updatedAt?: Date;
  };
}

const {
  locale,
  title = site.title[locale],
  description = site.description[locale],
  languageHref,
  alternates = [],
  article,
} = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f1e8" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.locale} href={alternate.href} />
    ))}
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {article && <meta property="article:published_time" content={article.publishedAt.toISOString()} />}
    {article?.updatedAt && <meta property="article:modified_time" content={article.updatedAt.toISOString()} />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{ui[locale].skip}</a>
    <Header locale={locale} languageHref={languageHref} />
    <main id="main-content">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>

