---
import type { BlogPost } from "../lib/content";
import type { Locale } from "../data/site";
import { localizedPath, slugFromPostId } from "../lib/i18n";

interface Props {
  post: BlogPost;
  locale: Locale;
}

const { post, locale } = Astro.props;
const formattedDate = new Intl.DateTimeFormat(locale, { dateStyle: "long" }).format(post.data.publishedAt);
---

<article class="post-card">
  <p class="meta">{formattedDate}</p>
  <h3><a href={localizedPath(locale, `/blog/${slugFromPostId(post.id)}/`)}>{post.data.title}</a></h3>
  <p>{post.data.summary}</p>
  {post.data.tags.length > 0 && (
    <ul aria-label={locale === "zh-CN" ? "文章标签" : "Post tags"}>
      {post.data.tags.map((tag) => <li>{tag}</li>)}
    </ul>
  )}
</article>

<style>
  .post-card {
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-5);
  }

  .meta {
    color: var(--color-muted);
    font-size: var(--step--1);
    margin: 0 0 var(--space-2);
  }

  h3 {
    font-size: var(--step-2);
    margin: 0;
  }

  h3 a {
    color: var(--color-text);
    text-decoration-color: transparent;
  }

  h3 a:hover,
  h3 a:focus-visible {
    color: var(--color-accent);
    text-decoration-color: currentColor;
  }

  article > p:last-of-type {
    color: var(--color-muted);
    max-width: 65ch;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
  }

  li {
    background: var(--color-surface);
    border-radius: 999px;
    color: var(--color-muted);
    font-size: var(--step--2);
    padding: 0.25rem 0.6rem;
  }
</style>

